<h2>02: nedb - insert, sort</h2>
<form action="/handleForm" method="post">
    <input class="form__input" type="text" placeholder="login" name="login" id="login">
    <input class="form__input" type="text" placeholder="password" name="password" id="password">
    <button type="submit">Zapisz</button>
</form>
<div class="user__table">
    <div class="header">id</div>
    <div class="header">login</div>
    <div class="header">password</div>
    <div class="header">timestamp</div>
    {{#with users as | users |}}
        {{#each users as | user |}}
            {{#with user}}
                <div class="index">{{@index}}</div>
                <div class="field">{{login}}</div>
                <div class="field">{{password}}</div>
                <div class="field">{{timestamp}}</div>
            {{/with}}
        {{/each}}
    {{else}}
    {{/with}}
    </div>