<div class="row page-body">
    <div class="col-2 text-center py-2 bg-body-tertiary d-flex flex-column px-4 gap-3" style="min-height: 100vh;">
        <h6 class="mt-2 text-start">filemanager</h6>
        <a href="#" role="button" data-bs-toggle="modal" data-bs-target="#addFolder" class="btn btn-secondary py-2 text-start"><i class="bi bi-folder-plus"></i> new folder</a>
        <a href="#" role="button" data-bs-toggle="modal" data-bs-target="#addFile" class="btn btn-secondary py-2 text-start"><i class="bi bi-file-earmark-plus"></i> new text file</a>
        <a href="#" role="button" data-bs-toggle="modal" data-bs-target="#renameCurrent" class="btn btn-secondary py-2 text-start"><i class="bi bi-pencil-square"></i> rename folder</a>
        {{> uploadForm currentDir=currentDir }}
        <a href="/edit-color-themes" style="margin-top: auto" role="button" class="btn btn-transparent py-2 text-start"><i class="bi bi-palette-fill"></i> edit themes</a>
    </div>
    <div class="col-10 p-3">
        <div class="current-dir__wrapper w-full mb-4">
            <a href="/" class="home-route route">
                <i class="bi bi-house"></i> home
            </a>
            {{#each (getRouteElements currentDir) as |route|}}
            <div class="route-separator">/</div>
            <a href="/filemanager/{{path}}" class=" route">
                {{ route.name }}
            </a>
            {{/each}}
        </div>
        <h4>Folders</h4>
        <div class="folder__wrapper">
        {{#each files as | file | }}
            {{#if file.isDirectory}}
                {{> folderCard folder=file}}
            {{/if}}
        {{/each}}
        </div>
        <h4 class="mt-3">Files</h4>
        <div class="file__wrapper mt-3">
        {{#each files as | file | }}
            {{#unless file.isDirectory}}
                {{> fileCard file=file}}
            {{/unless}}
        {{/each}}
        </div>
    </div>
</div>

<div class="modal fade in" id="addFolder" tabindex="-1" aria-labelledby="addFolderLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="addFolderLabel">Add Folder</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form action="/add" method="post">
                    <input type="hidden" name="isDirectory" value="true">
                    <input type="hidden" name="relativePath" value="{{ currentDir }}">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="folderName" name="entityName" placeholder="New Folder">
                        <label for="folderName">Folder Name</label>
                    </div>
                    <div class="d-inline-flex gap-3 mt-4">
                          <button class="btn btn-primary py-2" type="submit">Add</button>
                          <button class="btn btn-primary py-2" type="button"  data-bs-dismiss="modal" aria-label="Close">Close</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade in" id="addFile" tabindex="-1" aria-labelledby="addFileLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="addFileLabel">Add File</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form action="/add" method="post">
                    <input type="hidden" name="relativePath" value="{{ currentDir }}">
                    <div class="input-group mb-3">
                        <div class="form-floating" style="flex-grow: 8">
                            <input type="text" class="form-control" id="fileName" name="entityName" placeholder="New File">
                            <label for="fileName">File Name</label>
                        </div>
                        <span class="input-group-text" id="dot-addition">.</span>
                        <select data-width="50%" class="form-select" aria-label="FileExtensionSelect" name="entityExtension" id="entityExtension" style="width: 1rem !important;">
                            <option selected value="txt">txt</option>
                            <option value="css">css</option>
                            <option value="json">json</option>
                            <option value="html">html</option>
                        </select>
                    </div>
                    <div class="d-inline-flex gap-3 mt-4">
                          <button class="btn btn-primary py-2" type="submit">Add</button>
                          <button class="btn btn-primary py-2" type="button"  data-bs-dismiss="modal" aria-label="Close">Close</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade in" id="renameCurrent" tabindex="-1" aria-labelledby="renameCurrentLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="renameCurrentLabel">Rename current folder</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form action="/renameFolder" method="post">
                    <input type="hidden" name="relativePath" value="{{ currentDir }}">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="newFolderName" name="newFolderName" placeholder="New Folder">
                        <label for="newFolderName">File Name</label>
                    </div>
                    <div class="d-inline-flex gap-3 mt-4">
                          <button class="btn btn-primary py-2" type="submit">Add</button>
                          <button class="btn btn-primary py-2" type="button"  data-bs-dismiss="modal" aria-label="Close">Close</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
