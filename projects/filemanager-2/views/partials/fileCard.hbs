<form class="file-card__wrapper" onsubmit="return confirm('czy usunąć?')">
  <div class="d-flex align-items-center gap-3">
    <i class="bi {{ getFileIcon file }}"></i>
    <h6 class="m-0">{{ clipFileName file.name }}</h6>
  </div>
  <button formaction="/delete/{{file.name}}"><i class="bi bi-x"></i></button>
</form>