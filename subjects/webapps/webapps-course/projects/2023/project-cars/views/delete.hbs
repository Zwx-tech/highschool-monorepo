<div class="container">
  <h1 class="project-name">Delete page</h1>
  <form onsubmit="return confirm('czy usunąć?')">
    <div class="d-grid gap-2 d-md-flex">
      <button class="btn btn-danger me-md-2" type="submit" formaction="/deleteAll">DELETE ALL CARS</button>
      <button class="btn btn-dark" type="submit" formaction="/deleteSelected">DELETE SELECTED</button>
    </div>
    {{#if deletedCars includeZero=false}}
      <div class="alert alert-danger mt-4" role="alert">
        Removed {{ deletedCars }} cars
      </div>
    {{/if}}
    <table class="table mt-4">
    <thead>
     <tr>
      <th scope="col">_id</th>
      <th scope="col">ubezpieczony</th>
      <th scope="col">benzyna</th>
      <th scope="col">uszkodzony</th>
      <th scope="col">napęd4x4</th>
      <th scope="col"></th>
      <th scope="col"></th>
    </tr>
    </thead>
    <tbody>
      {{#each cars as | car |}}
      <tr>
          <th>{{ car._id }}</th>
          <td>
            {{ car.ubezpiecznie }}
          </td>
          <td>{{ car.benzyna }}</td>
          <td>{{ car.uszkodzony }}</td>
          <td>{{ car.naped }}</td>
          <td>
            <button class="btn btn-danger" type="submit" name="{{car._id}}" formaction="/deleteSingle">DELETE</button>
          </td>
          <td>
            <input class="form-check-input" type="checkbox" name="{{car._id}}"/>
          </td>
      </tr>
      {{/each}}
    </tbody>  
  </table>
  </form>
</div>